{
  "name": "support-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/widget.ts --bundle --format=iife --target=es2020 --outfile=dist/widget.js && esbuild src/widget.ts --format=esm --target=es2020 --outfile=dist/widget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/widget.test.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}